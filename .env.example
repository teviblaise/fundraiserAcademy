# Set these through your hosting provider's secure configuration.
NODE_ENV=production
PORT=3000
COOKIE_SECURE=true
APP_ORIGIN=
DATABASE_PATH=/app/data/academy.sqlite
# Resend: provide a verified sender and enter the API key securely.
EMAIL_FROM=
RESEND_API_KEY=
