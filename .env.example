# Set these through your hosting provider's secure configuration.
NODE_ENV=production
PORT=3000
COOKIE_SECURE=true
APP_ORIGIN=
DATABASE_PATH=/app/data/academy.sqlite
# Resend handles signup confirmation, password recovery/security mail, and optional alerts.
# Use a sender on your verified domain and enter the API key securely.
EMAIL_FROM=
RESEND_API_KEY=
# Intraday forex execution requires a Twelve Data plan supporting your forex pairs.
# Optional for crypto-only paper trading. Enter the key securely in hosting settings.
TWELVE_DATA_API_KEY=
# Public Coinbase streaming is enabled by default. Set false to use REST polling.
CRYPTO_STREAMING_ENABLED=true
# Optional generative support AI. The academy FAQ guide works without this key.
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=gpt-4.1-mini
# Comma-separated registered, verified staff emails; never set this from a form.
SUPPORT_STAFF_EMAILS=
# Comma-separated initial owner emails. Each must register, confirm email, and
# enroll an authenticator before admin access. Never accept this from signup.
# Existing Render services must set this in Render > Environment separately.
ADMIN_OWNER_EMAILS=
# Optional company-provided PDF or UTF-8 text contract outside public/.
# CONTRACT_FILE=/secure/trader-agreement.pdf
# CONTRACT_VERSION=v1
# CONTRACT_TITLE=Fundraiser Academy Trader Agreement

# Optional local encryption key: stable base64 32 bytes injected directly.
# Default uses private data/two-factor-key.json; back it up with the database.
# Never rotate this value or discard the key file while enrolled records remain.
# TWO_FACTOR_ENCRYPTION_KEY=
